{
  "expo": {
    "name": "Ashi Player",
    "slug": "ashi-player",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tikce.ashiplayer",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "اتصال به سرور پخش موزیک روی کامپیوتر"
      }
    },
    "plugins": [
      "./plugins/withVectorIcons.js"
    ]
  }
}